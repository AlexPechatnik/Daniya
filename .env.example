# ─── База данных ──────────────────────────────────────────────────────────
# Для локалки достаточно SQLite-файла.
# Для прода поменять провайдер в prisma/schema.prisma на postgresql и URL ниже.
DATABASE_URL="file:./dev.db"

# ─── Сессии CRM ───────────────────────────────────────────────────────────
# Любая случайная строка ≥ 32 символов. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_PASSWORD=""

# Публичный HTTPS-URL сайта (нужен для webhook'ов мессенджеров).
# Локально — адрес ngrok / cloudflared. В проде — ваш домен.
PUBLIC_BASE_URL=""

# ─── Telegram бот ─────────────────────────────────────────────────────────
# Токен от @BotFather. Один бот обслуживает клиентов, мастеров и админов.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
# chat_id админа(ов) для рассылки новых заявок. Можно несколько через запятую.
TELEGRAM_ADMIN_CHAT_ID=""

# ─── Max (VK) бот ─ Заглушка до публикации Bot API ───────────────────────
MAX_BOT_TOKEN=""
MAX_WEBHOOK_SECRET=""
MAX_ADMIN_CHAT_ID=""

# ─── Публичные кнопки «Написать в бот» на сайте ───────────────────────────
# Нужен ОДИН из вариантов: либо username, либо полный URL.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
NEXT_PUBLIC_TELEGRAM_BOT_URL=""
NEXT_PUBLIC_MAX_BOT_USERNAME=""
NEXT_PUBLIC_MAX_BOT_URL=""

# ─── Контакты компании (отображаются на сайте) ────────────────────────────
COMPANY_PHONE="+7 (812) 000-00-00"
COMPANY_EMAIL="info@example.ru"
COMPANY_CITY="Санкт-Петербург"
