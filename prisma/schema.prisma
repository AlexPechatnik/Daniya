generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite не поддерживает enum — используем строковые константы.
// Допустимые значения проверяет приложение (Zod / TS типы).

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  name       String
  role       String   @default("MASTER") // ADMIN | MASTER
  phone      String?
  color      String?  // для отображения в календаре
  active     Boolean  @default(true)
  telegramId String?  @unique // chat_id в Telegram (привязка сотрудника)
  maxId      String?  @unique
  createdAt  DateTime @default(now())
  requests   Request[]
}

model ConversationState {
  // Состояние диалога с конкретным пользователем мессенджера.
  id         String   @id @default(cuid())
  provider   String   // MAX | TELEGRAM
  externalId String   // chat_id
  flow       String?  // "new_request" | null
  step       String?
  data       String?  // JSON со собранными ответами
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
  @@unique([provider, externalId])
}

model Client {
  id          String   @id @default(cuid())
  name        String
  org         String?  // название организации (если юр.лицо)
  phone       String   @unique
  email       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  addresses   Address[]
  printers    Printer[]
  requests    Request[]
  channels    ClientChannel[] // привязки к мессенджерам
  messages    Message[]
  @@index([phone])
}

model ClientChannel {
  id         String  @id @default(cuid())
  clientId   String
  provider   String  // MAX | TELEGRAM | WEB | PHONE
  externalId String  // user_id в мессенджере
  client     Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  @@unique([provider, externalId])
}

model Address {
  id               String  @id @default(cuid())
  clientId         String
  label            String? // "Офис", "Дом"
  address          String
  district         String? // авто-определяемый район СПб/ЛО для группировки маршрута
  lat              Float?  // координаты от Яндекс.Геокодера
  lng              Float?
  formattedAddress String? // канонический вид адреса от геокодера
  geocodedAt       DateTime?
  client           Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requests         Request[]
  @@index([district])
}

model Printer {
  id       String   @id @default(cuid())
  clientId String
  brand    String
  model    String
  notes    String?
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Cartridge {
  id         String    @id @default(cuid())
  brand      String
  model      String    // "HP CF283A"
  type       String    // "лазерный" / "струйный"
  compatible String?
  isOriginal Boolean   @default(false)
  isPopular  Boolean   @default(false)
  // Антизаправочный чип: требует замены при каждой заправке.
  // Доплата к цене заправки — берём `chipPrice` если задана, иначе глобальный дефолт 150 ₽.
  hasChip    Boolean   @default(false)
  chipPrice  Int?      // копейки; null = использовать дефолт
  // Ресурс в страницах при 5% заполнении — фактоид для прайса.
  pageYield  Int?
  prices     Price[]
  requests   Request[]
  printers   PrinterCartridge[]
  @@unique([brand, model])
  @@index([brand])
  @@index([model])
}

model PrinterModel {
  // Каталог моделей принтеров/МФУ. Заполняется из ТОП‑100 (prisma/data/printers.json).
  // Нужен, чтобы клиент ввёл модель принтера и система подсказала картридж.
  id         String   @id @default(cuid())
  brand      String   // HP / Canon / Brother / Epson / ...
  family     String   // "LaserJet Pro M404dn" — первый вариант из строки таблицы
  aliases    String   // JSON-массив строк-вариантов: ["M404dn","M404dw","M404n"]
  // Тип печати: laser | inkjet. Раньше определялся regex по kind — теперь хранится
  // явно, чтобы CRM мог переопределить вручную при ошибке автодетекта.
  printType  String   @default("laser")
  kind       String?  // "Принтер A4 mono" / "МФУ A4 mono" / "Струйный" / ...
  segment    String?  // "Офис", "Малый офис", "Дом"
  demand     String?  // A | B | C — рейтинг сервисной популярности (A = массовый)
  chipNote   String?  // комментарий про чип
  speedPpm   Int?     // скорость печати, страниц в минуту (заводская)
  cartridges PrinterCartridge[]
  @@unique([brand, family])
  @@index([brand])
  @@index([family])
}

model PrinterCartridge {
  // Many-to-many между моделью принтера и подходящими картриджами.
  printerModelId String
  cartridgeId    String
  printerModel   PrinterModel @relation(fields: [printerModelId], references: [id], onDelete: Cascade)
  cartridge      Cartridge    @relation(fields: [cartridgeId], references: [id], onDelete: Cascade)
  @@id([printerModelId, cartridgeId])
  @@index([cartridgeId])
}

model Service {
  id       String    @id @default(cuid())
  kind     String    // REFILL | REPLACE | DIAGNOSTIC | REPAIR | INKJET_REPAIR
  name     String
  slug     String    @unique
  // Категория группировки на странице прайса. Простая строка, чтобы не плодить таблицу:
  // visit_diagnostics | laser_refill | cartridge_replacement | printer_repair | ciss_inkjet_service | maintenance
  category       String?
  // Применимость к типу принтера: laser | inkjet | both. null = both.
  appliesTo      String?
  // Услуга считается «по картриджу» (заправка, замена) — для калькулятора.
  // Услуги ремонта/диагностики/СНПЧ — нет.
  cartridgeBased Boolean  @default(false)
  // Текст-уточнение для прайса/формы: «уточняется после диагностики» и т.п.
  priceNote      String?
  // Подсказка под названием услуги (заменяет хардкоды CATEGORY_HINTS / SERVICE_FACTS).
  description    String?
  sortOrder      Int      @default(0)
  // Soft-delete: услугу не удаляем (на неё ссылаются заявки), а архивируем.
  archived       Boolean  @default(false)
  prices         Price[]
  requests       Request[]
}

model Price {
  id          String   @id @default(cuid())
  serviceId   String
  cartridgeId String?
  amount      Int      // в копейках
  note        String?
  updatedAt   DateTime @updatedAt
  service     Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  cartridge   Cartridge? @relation(fields: [cartridgeId], references: [id], onDelete: SetNull)
  @@index([serviceId])
  @@index([cartridgeId])
}

model Request {
  id            String   @id @default(cuid())
  number        Int      @unique // присваивается в коде при создании
  clientId      String
  addressId     String?
  serviceId     String?
  cartridgeId   String?
  printerInfo   String?
  quantity      Int      @default(1)
  status        String   @default("NEW")    // NEW | ACCEPTED | SCHEDULED | EN_ROUTE | ON_SITE | IN_PROGRESS | DONE | CANCELLED | AWAITING_PAYMENT
  paymentStatus String   @default("UNPAID") // UNPAID | PAID | PARTIAL
  source        String   @default("WEB")    // MAX | TELEGRAM | WEB | PHONE
  assignedToId  String?
  scheduledAt   DateTime?
  durationMin   Int      @default(60)
  price         Int?     // копейки
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  client        Client     @relation(fields: [clientId], references: [id])
  address       Address?   @relation(fields: [addressId], references: [id])
  assignedTo    User?      @relation(fields: [assignedToId], references: [id])
  service       Service?   @relation(fields: [serviceId], references: [id])
  cartridge     Cartridge? @relation(fields: [cartridgeId], references: [id])
  messages      Message[]
  @@index([status])
  @@index([scheduledAt])
  @@index([assignedToId])
}

model Message {
  id         String   @id @default(cuid())
  clientId   String
  requestId  String?
  provider   String   // MAX | TELEGRAM | WEB | PHONE
  direction  String   // "in" | "out"
  text       String
  meta       String?  // JSON-строка с сырым payload от мессенджера
  // unread = true для входящих, пока мастер не открыл диалог
  unread     Boolean  @default(true)
  createdAt  DateTime @default(now())
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  request    Request? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  @@index([clientId])
  @@index([requestId])
  @@index([unread])
}

model AppSetting {
  // Универсальное key-value хранилище настроек, чтобы не плодить таблицы.
  // Значение — JSON-строка, типизация делается в src/lib/settings.ts.
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Holiday {
  // Нерабочий день. Может быть привязан к конкретному мастеру или общий (userId = null).
  id        String   @id @default(cuid())
  date      DateTime // YYYY-MM-DD 00:00:00
  reason    String?  // "Выходной", "Отпуск", "Праздник"
  userId    String?  // null = общий для всех мастеров
  createdAt DateTime @default(now())
  @@unique([date, userId])
  @@index([date])
}

model PairingToken {
  // Одноразовый код для привязки сотрудника к боту через deep-link.
  // Админ нажимает «Привязать» в CRM → выдаём token → сотрудник идёт в t.me/bot?start=PAIR-<token>
  // Бот видит payload, ставит User.telegramId = chat_id, помечает токен использованным.
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  provider  String   // TELEGRAM | MAX
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
}

model RequestLead {
  // Заявка с публичной формы, ещё не привязана к клиенту
  id          String   @id @default(cuid())
  name        String
  phone       String
  address     String?
  serviceKind String?  // REFILL | REPLACE | DIAGNOSTIC | REPAIR
  cartridge   String?
  comment     String?
  createdAt   DateTime @default(now())
  processed   Boolean  @default(false)
}
