# Пример продового .env (на VPS назвать .env.production).
# В compose уже подключено через env_file.

# Postgres из docker-compose
DATABASE_URL="postgresql://printcare:printcare@db:5432/printcare?schema=public"
POSTGRES_PASSWORD="смените-меня-на-любой-пароль"

# Если не хотите Postgres и хотите SQLite:
# DATABASE_URL="file:/app/data/prod.db"

# Длинная случайная строка. Сгенерировать:
#   openssl rand -hex 48
SESSION_PASSWORD=""

# Поддомен, под которым будет жить сайт
PUBLIC_BASE_URL="https://printcare.example.com"

# Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_ADMIN_CHAT_ID=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# Max — стаб, можно оставить пустым
MAX_BOT_TOKEN=""
MAX_WEBHOOK_SECRET=""
MAX_ADMIN_CHAT_ID=""
NEXT_PUBLIC_MAX_BOT_USERNAME=""

# Контакты компании на сайте
COMPANY_PHONE="+7 (812) 000-00-00"
COMPANY_EMAIL="info@example.ru"
COMPANY_CITY="Санкт-Петербург"

# Если запускаете seed только при пустой БД
RUN_SEED_IF_EMPTY=1
